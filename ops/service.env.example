# 집 PC 상시 가동 설정. 실제 파일은 저장소 밖 %LOCALAPPDATA%\woowang\service.env (install_always_on.ps1 이 이 예시로 만든다).
# 이 파일(.example)만 저장소에 있고 service.env 는 .gitignore 로 막는다. 키 값은 절대 커밋하지 않는다.
# 형식: KEY=VALUE, # 주석. 값에 공백·한글 경로가 있어도 따옴표 없이 쓴다.

# 저장소·실행 파일 (설치 스크립트가 실제 경로로 채운다)
REPO_DIR=
PYTHON_EXE=
OLLAMA_EXE=
OLLAMA_MODELS=
HF_HOME=

# 모델 서비스
MODEL_HOST=127.0.0.1
MODEL_PORT=8010
MODEL_API_KEYS=CHANGE_ME
MODEL_KEEP_ALIVE=-1
MODEL_LOG_LEVEL=info

# Ollama 서버 환경변수 (ollama.exe serve 가 읽는다)
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1

# NER 모델 캐시만 쓰기(허브 접속 안 함). 모델을 새로 받아야 하면 0
HF_OFFLINE=1

# 외부 LLM 키. 비우면 사용자 환경변수 ANTHROPIC_API_KEY(setx) 를 읽는다
ANTHROPIC_API_KEY=

# 감시
WATCHDOG_RETRY_SECONDS=20
WATCHDOG_WARM=1
LOG_KEEP=10
